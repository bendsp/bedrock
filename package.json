{
  "name": "bedrock",
  "productName": "Bedrock",
  "version": "1.3.3",
  "packageManager": "pnpm@10.32.1",
  "description": "A modern text editor - built with Electron and React",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendsp/bedrock"
  },
  "main": ".webpack/main",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "build": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin",
    "make:mac:arm64": "electron-forge make --platform=darwin --arch=arm64",
    "make:mac:x64": "electron-forge make --platform=darwin --arch=x64",
    "make:win": "electron-forge make --platform=win32",
    "publish": "electron-forge publish",
    "publish:mac": "electron-forge publish --platform=darwin",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:unit": "ts-node --project tsconfig.typecheck.json tests/index.ts",
    "build:e2e": "electron-forge package",
    "test:e2e": "pnpm run build:e2e && playwright test",
    "test": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:release && pnpm run test:e2e",
    "linear:create-issue": "node ./scripts/linear/create-issue.mjs",
    "repo:sync-labels": "node ./scripts/github/sync-labels.mjs",
    "repo:protect-main": "node ./scripts/github/protect-main.mjs",
    "install:local": "node scripts/install-local.mjs",
    "test:release": "node --test tests/release.test.mjs"
  },
  "keywords": [],
  "author": {
    "name": "Ben Desprets",
    "email": "benjy.desprets@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.1.1",
    "@electron/osx-sign": "^2.7.0",
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^18.19.130",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.11.0",
    "autoprefixer": "^10.5.5",
    "css-loader": "^6.11.0",
    "dotenv": "^17.4.2",
    "electron": "43.6.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "semver": "^7.8.5",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.19",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/electron": "^7.18.0",
    "@types/markdown-it": "^14.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "electron-squirrel-startup": "^1.0.1",
    "electron-window-state": "^5.0.3",
    "github-markdown-css": "^5.9.0",
    "katex": "^0.18.7",
    "lucide-react": "^0.460.0",
    "markdown-it": "^14.3.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0"
  }
}
